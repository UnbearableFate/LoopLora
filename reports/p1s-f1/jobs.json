    "source": {
      "kind": "commit",
      "ref": "a76e46b4e4cc104fbf177706736b4cbed2a88aa2"
    },
    "argv": [
      "-c",
      "import json\nfrom pathlib import Path\nfrom collections import defaultdict\nroot=Path(\"/work/xg24i002/x10041/LoopLora-wt/symf/reports/p1s-f1\")\ngroups=defaultdict(lambda: [0,0,0])\nfor row in json.loads((root/\"swap_successors.json\").read_text()):\n    if row[\"L\"]==4 and row[\"variant\"] in (\"M1\",\"M1-lin\",\"B5\",\"B5-lin\",\"B3\"):\n        key=(row[\"writer\"],row[\"r\"],row[\"variant\"],row[\"new_hop_le_L\"])\n        for i,name in enumerate((\"n\",\"follow_count\",\"unswapped_follow_count\")):\n            groups[key][i]+=row[name]\nsummary=[]\nfor (writer,rank,variant,reach), (n,follow,old) in sorted(groups.items()):\n    summary.append(dict(writer=writer,r=rank,variant=variant,L=4,new_hop_le_L=reach,n=n,\n                        follow_rate=follow/n,unswapped_follow_rate=old/n,paired_difference=(follow-old)/n,gating=False))\n(root/\"swap_successors_L4_summary.json\").write_text(json.dumps(summary,indent=2)+\"\\n\")\nfor row in summary:\n    if row[\"new_hop_le_L\"]==\"all\":\n        print(\"A5\",row[\"writer\"],row[\"r\"],row[\"variant\"],round(100*row[\"follow_rate\"],2),round(100*row[\"unswapped_follow_rate\"],2),round(100*row[\"paired_difference\"],2))\nfor row in json.loads((root/\"reported_contrasts.json\").read_text()):\n    if row[\"dataset\"]==\"unseen\" and row[\"endpoint\"] in (\"reach\",\"specificity\",\"vs_fixed\"):\n        p=row[\"statistics\"][\"gate\"]\n        print(\"UNSEEN\",row[\"writer\"],row[\"r\"],row[\"reader\"],row[\"endpoint\"],round(100*p[\"difference\"],2),[round(100*p[\"ci_low\"],2),round(100*p[\"ci_high\"],2)])\nb3=[row for row in summary if row[\"variant\"]==\"B3\"]\nassert all(row[\"paired_difference\"]==0 for row in b3), \"B3 changed predictions after a memory-only edit\"\nprint(\"B3 paired successor-swap differences are exactly zero.\")\n"
    ],
